# Environment configuration for TIMEPASS
PORT=3000
NODE_ENV=development

# Socket.IO & Realtime
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Prisma SQLite default for local zero-config, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Auth Secret
JWT_SECRET="timepass_jwt_production_secret_key_needs_to_be_long_and_secure_64chars"

# Admin Access Key for moderation & system oversight
ADMIN_SECRET_KEY="admin123"

# WebRTC STUN/TURN Config
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"
TURN_SERVER_URL=""
TURN_SERVER_USERNAME=""
TURN_SERVER_CREDENTIAL=""

# SMS / OTP Verification
SMS_PROVIDER="sandbox"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
